# URL de base de l'API backend TERRAVA-AI.
# Le port par défaut du backend est 8000 (voir README), mais il peut être
# occupé par un autre service sur votre machine. Si vous lancez le backend
# sur un autre port, adaptez la valeur ci-dessous dans un fichier .env local
# (non commité).
VITE_API_BASE_URL=http://localhost:8000
